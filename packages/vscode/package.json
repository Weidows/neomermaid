{
  "name": "neomermaid-vscode",
  "displayName": "NeoMermaid",
  "description": "Beautiful, themeable mermaid preview — themes, colour schemes and export to SVG/PNG.",
  "version": "0.1.2",
  "publisher": "weidows",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mermaid",
    "diagram",
    "preview",
    "flowchart",
    "theme",
    "svg"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:mermaid",
    "onCommand:neomermaid.openPreview",
    "onCommand:neomermaid.openPreviewToSide",
    "onCommand:neomermaid.exportPng",
    "onCommand:neomermaid.exportSvg",
    "onCommand:neomermaid.copySvg",
    "onCommand:neomermaid.choosePreset"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid",
          "mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/preview.svg",
          "dark": "./media/preview.svg"
        }
      }
    ],
    "commands": [
      {
        "command": "neomermaid.openPreview",
        "title": "NeoMermaid: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "neomermaid.openPreviewToSide",
        "title": "NeoMermaid: Open Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "neomermaid.exportPng",
        "title": "NeoMermaid: Export as PNG",
        "icon": "$(file-media)"
      },
      {
        "command": "neomermaid.exportSvg",
        "title": "NeoMermaid: Export as SVG",
        "icon": "$(file-code)"
      },
      {
        "command": "neomermaid.copySvg",
        "title": "NeoMermaid: Copy SVG to Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "neomermaid.choosePreset",
        "title": "NeoMermaid: Choose Theme & Palette",
        "icon": "$(color-mode)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "neomermaid.openPreviewToSide",
          "when": "editorLangId == mermaid",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "neomermaid.openPreviewToSide",
          "when": "editorLangId == mermaid",
          "group": "navigation"
        },
        {
          "command": "neomermaid.choosePreset",
          "when": "editorLangId == mermaid",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "neomermaid.exportPng",
          "when": "editorLangId == mermaid"
        },
        {
          "command": "neomermaid.exportSvg",
          "when": "editorLangId == mermaid"
        },
        {
          "command": "neomermaid.copySvg",
          "when": "editorLangId == mermaid"
        },
        {
          "command": "neomermaid.choosePreset",
          "when": "editorLangId == mermaid"
        }
      ]
    },
    "keybindings": [
      {
        "command": "neomermaid.openPreviewToSide",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorLangId == mermaid"
      }
    ],
    "configuration": {
      "title": "NeoMermaid",
      "properties": {
        "neomermaid.defaultPreset": {
          "type": "string",
          "default": "minimal/github-light",
          "markdownDescription": "Preset (`<theme>/<palette>`) used while `#neomermaid.followEditorTheme#` is off. Run **NeoMermaid: Choose Theme & Palette** to pick one, e.g. `neon/dracula`."
        },
        "neomermaid.followEditorTheme": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Pick `#neomermaid.lightPreset#` or `#neomermaid.darkPreset#` automatically from the active VS Code colour theme."
        },
        "neomermaid.lightPreset": {
          "type": "string",
          "default": "minimal/github-light",
          "markdownDescription": "Preset used in light editor themes."
        },
        "neomermaid.darkPreset": {
          "type": "string",
          "default": "neon/dracula",
          "markdownDescription": "Preset used in dark editor themes."
        },
        "neomermaid.background": {
          "type": "string",
          "default": "theme",
          "markdownDescription": "Canvas colour: `theme`, `transparent`, or any CSS colour."
        },
        "neomermaid.padding": {
          "type": "number",
          "default": 16,
          "minimum": 0,
          "maximum": 96,
          "description": "Canvas padding in pixels."
        },
        "neomermaid.exportScale": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "Raster scale factor used by \"Export as PNG\"."
        },
        "neomermaid.liveUpdateDelay": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 2000,
          "description": "Debounce (ms) before re-rendering while typing."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The preview renders the mermaid text you opened inside a webview whose CSP allows no remote or inline scripts."
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-vscode.mjs",
    "package": "npx --yes @vscode/vsce@latest package --no-dependencies",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/webview-smoke.mjs",
    "smoke:host": "node scripts/host-smoke.mjs",
    "verify": "npm run typecheck && npm run build && npm run smoke:host && npm run smoke"
  },
  "files": [
    "dist",
    "media",
    "language-configuration.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@neomermaid/core": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weidows/neomermaid.git",
    "directory": "packages/vscode"
  },
  "icon": "media/icon.png"
}
