{
  "name": "neomermaid-vscode",
  "displayName": "NeoMermaid",
  "description": "Beautiful, themeable mermaid preview — themes, colour schemes and export to SVG/PNG.",
  "version": "0.1.0",
  "publisher": "weidows",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Visualization", "Programming Languages", "Other"],
  "keywords": ["mermaid", "diagram", "preview", "flowchart", "theme", "svg"],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:mermaid",
    "onCommand:neomermaid.openPreview",
    "onCommand:neomermaid.openPreviewToSide",
    "onCommand:neomermaid.exportPng",
    "onCommand:neomermaid.exportSvg",
    "onCommand:neomermaid.copySvg"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mermaid",
        "aliases": ["Mermaid", "mermaid"],
        "extensions": [".mmd", ".mermaid"],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      { "command": "neomermaid.openPreview", "title": "NeoMermaid: Open Preview", "icon": "$(open-preview)" },
      { "command": "neomermaid.openPreviewToSide", "title": "NeoMermaid: Open Preview to the Side", "icon": "$(open-preview)" },
      { "command": "neomermaid.exportPng", "title": "NeoMermaid: Export as PNG", "icon": "$(file-media)" },
      { "command": "neomermaid.exportSvg", "title": "NeoMermaid: Export as SVG", "icon": "$(file-code)" },
      { "command": "neomermaid.copySvg", "title": "NeoMermaid: Copy SVG to Clipboard", "icon": "$(clippy)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "neomermaid.openPreviewToSide", "when": "editorLangId == mermaid", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "neomermaid.exportPng", "when": "editorLangId == mermaid" },
        { "command": "neomermaid.exportSvg", "when": "editorLangId == mermaid" },
        { "command": "neomermaid.copySvg", "when": "editorLangId == mermaid" }
      ]
    },
    "keybindings": [
      { "command": "neomermaid.openPreviewToSide", "key": "ctrl+shift+m", "mac": "cmd+shift+m", "when": "editorLangId == mermaid" }
    ],
    "configuration": {
      "title": "NeoMermaid",
      "properties": {
        "neomermaid.defaultPreset": {
          "type": "string",
          "default": "minimal/github-light",
          "description": "Theme/palette pair used when a preview opens, e.g. neon/dracula."
        },
        "neomermaid.followEditorTheme": {
          "type": "boolean",
          "default": true,
          "description": "Pick a light or dark preset automatically from the active VS Code colour theme."
        },
        "neomermaid.background": {
          "type": "string",
          "default": "theme",
          "description": "Canvas colour: 'theme', 'transparent', or any CSS colour."
        },
        "neomermaid.padding": {
          "type": "number",
          "default": 16,
          "description": "Canvas padding in pixels."
        },
        "neomermaid.exportScale": {
          "type": "number",
          "default": 2,
          "description": "Raster scale factor used by \"Export as PNG\"."
        },
        "neomermaid.liveUpdateDelay": {
          "type": "number",
          "default": 250,
          "description": "Debounce (ms) before re-rendering while typing."
        }
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-vscode.mjs",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@neomermaid/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weidows/neomermaid.git",
    "directory": "packages/vscode"
  }
}
